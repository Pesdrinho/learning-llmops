# ============================================
# LLMOps Lab - Configuração de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# ============================================

# ----- API Keys -----
OPENROUTER_API_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LANGSMITH_API_KEY=your_langsmith_key_here
BRAPI_TOKEN=your_brapi_token_here

# ----- Google Cloud Platform -----
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Cloud SQL
DB_CONNECTION_NAME=your-project:us-central1:llmops-db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llmops
DB_USER=llmops_user
DB_PASSWORD=your_db_password

# Database URL (local dev)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_URL_SYNC=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Cloud Storage
GCS_RAG_DOCS_BUCKET=llmops-rag-docs
GCS_DATASETS_BUCKET=llmops-datasets

# ----- Rate Limiting & Cost Control -----
BUDGET_USD_DAY=15.00
MAX_REQUESTS_PER_MINUTE=60

# ----- MCP Server -----
MCP_SERVER_URL=https://mcp-server-xxxxx.run.app
MCP_AUTH_TOKEN=your_mcp_token_here

# ----- Model Configuration -----
# Default models para cada caso de uso
DEFAULT_MODEL_FAST=openrouter/gpt-3.5-turbo
DEFAULT_MODEL_PRECISE=anthropic/claude-3.5-sonnet
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Fine-tuning
FT_MODEL_NAME=Qwen/Qwen-7B-Chat
FT_MODEL_PATH=/models/qwen-ft-tool-use
FT_ADAPTER_PATH=/models/qwen-ft-tool-use/adapter

# ----- Application Settings -----
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# ----- LangSmith Tracing -----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=llmops-lab

# ----- Crawler Configuration -----
CRAWLER_SCHEDULE_CRON=0 0 * * *
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=30

# ----- RAG Configuration -----
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.7

# ----- Guardrails -----
GUARDRAILS_ENABLED=true
PII_MASKING_ENABLED=true

# ----- Feature Flags -----
ENABLE_CACHE=true
ENABLE_RERANK=false
ENABLE_NEMO_GUARDRAILS=true
